# Copy to deploy/.env and adjust. Used by deploy/docker-compose.yml.
FORGE_NAME=Forge

# Host ports, and the addresses users connect to (keep them in sync).
FORGE_SSH_PORT=23231
FORGE_HTTP_PORT=23232
FORGE_SSH_PUBLIC_ADDR=localhost:23231
FORGE_HTTP_PUBLIC_URL=http://localhost:23232

# Your public key; gets the "admin" account on first start.
FORGE_INITIAL_ADMIN_KEYS=ssh-ed25519 AAAA... you@laptop

# Private instance: unknown SSH keys are refused, HTTP needs a token.
FORGE_ANONYMOUS_READ=false
FORGE_ALLOW_REGISTRATION=false

FORGE_LOG_FORMAT=json
FORGE_LOG_LEVEL=info

# Runner (docker compose --profile runner up -d). Create the token with:
#   docker compose -f deploy/docker-compose.yml exec forge forge admin runner create compose
FORGE_RUNNER_TOKEN=
FORGE_RUNNER_CONCURRENCY=2
# Let jobs use the host's Docker (docker build/push); gives jobs root on the host.
#FORGE_RUNNER_DOCKER_SOCKET=/var/run/docker.sock
